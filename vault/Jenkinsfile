pipeline {
    agent any
    
    stages {
        stage('Get Dynamic DB Credentials') {
            steps {
                script {
                    def secrets = [
                        [
                            path: 'database/creds/dynamic-role',
                            engineVersion: 1,
                            secretValues: [
                                [envVar: 'DB_USERNAME', vaultKey: 'username'],
                                [envVar: 'DB_PASSWORD', vaultKey: 'password']
                            ]
                        ]
                    ]
                    
                    withVault([vaultSecrets: secrets]) {
                        echo "Successfully retrieved dynamic credentials from Vault!"
                        echo "Username: ${DB_USERNAME}"
                        
                        // Test the credentials by connecting to PostgreSQL and running a simple query
                        sh '''
                            PGPASSWORD="${DB_PASSWORD}" psql -h postgres -U "${DB_USERNAME}" -d vaultdb -c "SELECT current_user, current_database(), now();"
                        '''
                        
                        echo "Database connection successful! Credentials are valid."
                    }
                }
            }
        }
    }
}
